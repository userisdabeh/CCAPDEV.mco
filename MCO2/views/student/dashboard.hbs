<main>
  <div class="top--bar">
    <div class="text-w-subtitle">
      <h1>Dashboard</h1>
      <p class="disabled-text">Welcome back! Here's an overview of your reservations.</p>
    </div>
    <div class="quick--actions">
      <a href="/student/reserve/{{user._id}}" class="btn-w-icon btn-1" style="margin-top: 1rem; display: inline-flex; align-items: center; gap: 6px;">
        <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#000000">
          <path d="M120-120v-80h80v-640h400v40h160v600h80v80H680v-600h-80v600H120Zm160-640v560-560Zm160 320q17 0 28.5-11.5T480-480q0-17-11.5-28.5T440-520q-17 0-28.5 11.5T400-480q0 17 11.5 28.5T440-440ZM280-200h240v-560H280v560Z"/>
        </svg>
        Make a Reservation
      </a>
    </div>
  </div>

  <div class="reservations--container">
    <div class="list--header">
      <h2>Recent Reservations</h2>
    </div>

    <div class="summary">
      <div class="summary--card">
        <h4>Total Reservations</h4>
        <div class="card--text">
          <p>{{totalThisMonth}}</p>
          <p class="disabled-text">This month</p>
        </div>
      </div>

      <div class="summary--card">
        <h4>Active Reservations</h4>
        <div class="card--text">
          <p>{{activeReservations}}</p>
          <p class="disabled-text">Currently active</p>
        </div>
      </div>
    </div>

    <br><br>

    <div class="table-container">
      {{#if recentReservations}}
        <table class="reservations-table">
          <thead>
            <tr>
              <th>Room</th>
              <th>Date</th>
              <th>Time Slot</th>
              <th>Name</th>
              <th>Status</th>
              <th>Reserved At</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each recentReservations}}
              <tr>
                <td>{{#if roomID}}{{roomID.roomName}}{{else}}—{{/if}}</td>
                <td>{{formatDate reservationDate}}</td>
                <td>{{timeSlot}}</td>
                <td>{{#if anonymous}}Anonymous{{else}}{{name}}{{/if}}</td>
                <td>{{status}}</td>
                <td>{{formatDate createdAt}}</td>
                <td>
                  <form action="/student/delete/{{_id}}" method="POST" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                    <input type="hidden" name="userId" value="{{../user._id}}">
                    <button type="submit" class="btn-delete">Cancel</button>
                  </form>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <div class="table-header">
          <p class="disabled-text">
            No reservations found. Make your first reservation to get started!
          </p>
        </div>
      {{/if}}
    </div>
  </div>
</main>
