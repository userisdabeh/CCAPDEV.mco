<main>
  <section class="top--bar">
    <div class="text-w-subtitle">
      <h3>My Reservations</h3>
      <p class="disabled-text">View and manage your lab seat reservations</p>
    </div>
  </section>

  <section class="room-n-date-selector">
    <form id="reserveForm" data-student-id="{{user._id}}">
      <div class="search--field">
        <label for="roomSelect">Select a Lab: <span class="required-tag">*</span></label>
        <select name="room" id="roomSelect" class="user-input" required>
          <option value="" selected disabled>Select a room</option>
          {{#if rooms}}
            {{#each rooms}}
              <option value="{{this.roomName}}">{{this.roomName}}</option>
            {{/each}}
          {{/if}}
        </select>
      </div>
 <br> <br> <br>
      <div class="search--field">
        <label for="timeSelect">Select Time: <span class="required-tag">*</span></label>
        <select name="time" id="timeSelect" class="user-input" required>
          <option value="" selected disabled>Select a time</option>
          {{#if times}}
            {{#each times}}
              <option value="{{this}}">{{this}}</option>
            {{/each}}
          {{/if}}
        </select>
      </div>
 <br> <br> <br>
      <div class="search--field">
  <label for="dateSelect">Select Date: <span class="required-tag">*</span></label>
  <select name="date" id="dateSelect" class="user-input" required>
    <option value="" selected disabled>Select a date</option>
    {{#if dates}}
      {{#each dates}}
        <option value="{{this}}">{{this}}</option>
      {{/each}}
    {{/if}}
  </select>
</div>

 <br> <br> <br>
      <div class="search--field">
        <label for="nameInput">Name</label>
        <input type="text" id="nameInput" name="name" class="user-input" placeholder="Your name (or leave blank if anonymous)">
      </div>
    <br>
      <button type="submit" id="reserveBtn" class="search--room--btn">
        Reserve
      </button>

      <div id="formMessage" style="margin-top:1rem; font-weight:500;"></div>
    </form>
  </section>
</main>
